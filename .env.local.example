# Copia questo file in .env.local e compila con le chiavi del tuo progetto Supabase
# (Project Settings -> API, nel dashboard Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server-side: mai esporre al client, mai committare un valore reale.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) - generare con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL pubblico del sito (usato nei link delle email, es. reset password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
